# İstemcide bulunmasına izin verilen Supabase değerleri
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Yerel Vite geliştirme sunucusunda Worker API adresi boş bırakılabilir.
VITE_API_BASE_URL=

# Cloudflare Worker sırları `wrangler secret put` ile eklenir; bu dosyaya gerçek değer yazılmaz.
# SUPABASE_URL
# SUPABASE_PUBLISHABLE_KEY
# GEMINI_API_KEY
# USDA_API_KEY
# GEMINI_MODEL=gemini-2.5-flash-lite
